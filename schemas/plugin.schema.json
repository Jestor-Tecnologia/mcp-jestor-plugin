{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Jestor Cursor plugin contract (not an official Cursor schema)",
  "type": "object",
  "required": ["name", "version", "description", "author", "homepage", "keywords", "logo"],
  "additionalProperties": false,
  "properties": {
    "name": { "const": "jestor" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": { "name": { "const": "Jestor" } }
    },
    "homepage": { "const": "https://jestor.com/" },
    "keywords": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "logo": { "const": "assets/jestor-icon.svg" },
    "license": { "type": "string", "minLength": 1 }
  }
}
